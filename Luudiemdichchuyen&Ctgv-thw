local FOLDER_NAME = "BatmanTeleports_" .. tostring(game.PlaceId)
local savedLocations = {}
local locationCount = 0

local function SanitizeFileName(name)
    return string.gsub(name, '[\\/:*?"<>|]', "_")
end

local function InitFolder()
    if makefolder and not isfolder(FOLDER_NAME) then
        makefolder(FOLDER_NAME)
    end
end

local function SerializeCFrame(cf)
    return {cf:GetComponents()}
end

local function DeserializeCFrame(tab)
    return CFrame.new(unpack(tab))
end

local function SavePointToFile(name, cf)
    InitFolder()
    if writefile then
        local safeName = SanitizeFileName(name)
        local path = FOLDER_NAME .. "/" .. safeName .. ".json"
        local data = HttpService:JSONEncode({
            Name = name, 
            CFrameData = SerializeCFrame(cf)
        })
        pcall(function() writefile(path, data) end)
    end
end

local function DeletePointFile(name)
    if delfile then
        local safeName = SanitizeFileName(name)
        local path = FOLDER_NAME .. "/" .. safeName .. ".json"
        if isfile and isfile(path) then
            pcall(function() delfile(path) end)
        end
    end
end

-- ==========================================
-- CÁC HÀM DỊCH CHUYỂN
-- ==========================================
local function TeleportInstant(targetCFrame)
    local char = Player.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = targetCFrame
    end
end

local function TeleportSmooth(targetCFrame)
    local char = Player.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local hrp = char.HumanoidRootPart
        local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
        tween:Play()
    end
end

local function TeleportCFrameLoop(targetCFrame)
    local char = Player.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local hrp = char.HumanoidRootPart
        local startPos = hrp.Position
        local endPos = targetCFrame.Position
        local steps = 10 -- Số đoạn nhỏ
        local delayPerStep = 0.02 -- Độ trễ giữa các đoạn
        
        for i = 1, steps do
            if not char or not char:FindFirstChild("HumanoidRootPart") then break end
            local t = i / steps
            local newPos = startPos:Lerp(endPos, t)
            hrp.CFrame = CFrame.new(newPos) * targetCFrame.Rotation
            task.wait(delayPerStep)
        end
        
        -- Đảm bảo đến đúng vị trí cuối
        if char and char:FindFirstChild("HumanoidRootPart") then
            hrp.CFrame = targetCFrame
        end
    end
end

local function ExecuteTeleport(targetCFrame, tpButton)
    local oldColor = tpButton and tpButton.BackgroundColor3
    
    if currentTPMode == "Instant" then
        TeleportInstant(targetCFrame)
    elseif currentTPMode == "Smooth" then
        TeleportSmooth(targetCFrame)
    elseif currentTPMode == "CFrame Loop" then
        TeleportCFrameLoop(targetCFrame)
    end
    
    if tpButton then
        tpButton.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
        task.wait(0.2)
        tpButton.BackgroundColor3 = oldColor
    end
end


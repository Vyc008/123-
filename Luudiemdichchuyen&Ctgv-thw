local SETTINGS_FILE = "BatmanTeleports_Settings.json"
local currentTPMode = "Instant" -- Mặc định

local TP_MODES = {
    {Name = "⚡ Instant TP", Desc = "Dịch chuyển tức thời (nhanh nhất)"},
    {Name = "🌊 Smooth TP", Desc = "Dịch chuyển mượt mà với Tween"},
    {Name = "🔄 CFrame Loop", Desc = "Dịch chuyển từng đoạn nhỏ (an toàn nhất)"}
}

local function SaveSettings()
    if writefile then
        local data = HttpService:JSONEncode({TPMode = currentTPMode})
        pcall(function() writefile(SETTINGS_FILE, data) end)
    end
end

local function LoadSettings()
    if isfile and isfile(SETTINGS_FILE) then
        local success, content = pcall(function() return readfile(SETTINGS_FILE) end)
        if success then
            local s2, data = pcall(function() return HttpService:JSONDecode(content) end)
            if s2 and data.TPMode then
                -- Kiểm tra chế độ còn hợp lệ không (tránh lỗi từ file cũ)
                local validModes = {["Instant"] = true, ["Smooth"] = true, ["CFrame Loop"] = true}
                if validModes[data.TPMode] then
                    currentTPMode = data.TPMode
                end
            end
        end
    end
end


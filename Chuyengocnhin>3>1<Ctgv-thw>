--[[
    👁️ CAMERA VIEW CONTROLLER V4.1 (FIXED: ANTI-JITTER & ANIMATION COMPATIBILITY)
    🛡️ Chức năng: Khóa FOV, ép góc nhìn thứ nhất (nếu bật), thả tự do zoom ở góc nhìn thứ 3.
    🔥 Fix lỗi giật camera khi nằm hoặc khi game can thiệp vào camera offset.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer or Players.PlayerAdded:Wait()

-- Dùng CoreGui hoặc gethui() để UI không bị mất khi chuyển map/reset nhân vật
local CoreGui = (gethui and pcall(gethui)) and gethui() or game:GetService("CoreGui")

-- ================= BẢNG MÀU MINIMALIST =================
local Theme = {
    Background = Color3.fromRGB(25, 25, 27),
    Panel = Color3.fromRGB(35, 35, 40),
    Border = Color3.fromRGB(50, 50, 55),
    Text = Color3.fromRGB(230, 230, 230),
    Active = Color3.fromRGB(90, 170, 255) 
}
local MainFont = Enum.Font.GothamMedium

-- ================= DỌN DẸP SCRIPT CŨ TẬN GỐC =================
if CoreGui:FindFirstChild("CameraViewGui_Minimal") then
    CoreGui.CameraViewGui_Minimal:Destroy()
end
pcall(function()
    RunService:UnbindFromRenderStep("AbsoluteCameraLock_V3")
end)

-- ================= CẤU HÌNH GÓC NHÌN & FOV =================
local isFirstPerson = false
local cameraFOV = 70 -- Mặc định FOV Roblox
local isGuiMinimized = false

-- ================= HÀM HỖ TRỢ THIẾT KẾ =================
local function ApplyMinimalStyle(element)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = element

    local stroke = Instance.new("UIStroke")
    stroke.Color = Theme.Border
    stroke.Thickness = 1
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = element
end

local function CreateButton(parent, text, size, pos, textSize)
    local btn = Instance.new("TextButton")
    btn.Parent = parent
    btn.BackgroundColor3 = Theme.Panel
    btn.Size = size
    if pos then btn.Position = pos end
    btn.Font = MainFont
    btn.Text = text
    btn.TextColor3 = Theme.Text
    btn.TextSize = textSize or 12
    btn.AutoButtonColor = true
    ApplyMinimalStyle(btn)
    return btn
end

-- ================= TẠO GIAO DIỆN VÀO COREGUI =================
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "CameraViewGui_Minimal"
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.Parent = CoreGui 

local MainFrame = Instance.new("Frame")
MainFrame.Parent = ScreenGui
MainFrame.BackgroundColor3 = Theme.Background
MainFrame.Position = UDim2.new(0.05, 0, 0.4, 0)
MainFrame.Size = UDim2.new(0, 170, 0, 125)
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.ClipsDescendants = true
ApplyMinimalStyle(MainFrame)

local Title = Instance.new("TextLabel")
Title.Parent = MainFrame
Title.BackgroundTransparency = 1
Title.Size = UDim2.new(1, -45, 0, 35)
Title.Position = UDim2.new(0, 10, 0, 0)
Title.Font = Enum.Font.GothamBold
Title.Text = "Camera V4.1"
Title.TextColor3 = Theme.Text
Title.TextSize = 13
Title.TextXAlignment = Enum.TextXAlignment.Left

local MinimizeButton = Instance.new("TextButton")
MinimizeButton.Parent = MainFrame
MinimizeButton.BackgroundTransparency = 1
MinimizeButton.Size = UDim2.new(0, 45, 0, 35)
MinimizeButton.Position = UDim2.new(1, -45, 0, 0)
MinimizeButton.Font = Enum.Font.GothamBold
MinimizeButton.Text = "–"
MinimizeButton.TextColor3 = Theme.Text
MinimizeButton.TextSize = 22
MinimizeButton.ZIndex = 2

local InnerFrame = Instance.new("Frame")
InnerFrame.Parent = MainFrame
InnerFrame.BackgroundTransparency = 1
InnerFrame.Size = UDim2.new(1, -20, 1, -45)
InnerFrame.Position = UDim2.new(0, 10, 0, 35)

local ListLayout = Instance.new("UIListLayout", InnerFrame)
ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
ListLayout.Padding = UDim.new(0, 8)
ListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center

local ToggleViewBtn = CreateButton(InnerFrame, "GÓC NHÌN: TỰ DO", UDim2.new(1, 0, 0, 32), nil, 13)
ToggleViewBtn.Font = Enum.Font.GothamBold
ToggleViewBtn.LayoutOrder = 1

local FovFrame = Instance.new("Frame")
FovFrame.Parent = InnerFrame
FovFrame.BackgroundTransparency = 1
FovFrame.Size = UDim2.new(1, 0, 0, 28)
FovFrame.LayoutOrder = 2

local FovLayout = Instance.new("UIListLayout", FovFrame)
FovLayout.FillDirection = Enum.FillDirection.Horizontal
FovLayout.Padding = UDim.new(0, 6)
FovLayout.SortOrder = Enum.SortOrder.LayoutOrder

local FovDecBtn = CreateButton(FovFrame, "–", UDim2.new(0, 35, 1, 0), nil, 16)
local FovLabel = CreateButton(FovFrame, "FOV: " .. cameraFOV, UDim2.new(0, 68, 1, 0), nil, 11)
FovLabel.BackgroundColor3 = Theme.Background
local FovIncBtn = CreateButton(FovFrame, "+", UDim2.new(0, 35, 1, 0), nil, 16)

-- ================= LOGIC CẬP NHẬT CAMERA (CHỈ CHẠY 1 LẦN KHI BẤM) =================
local function ApplyCameraMode()
    if isFirstPerson then
        ToggleViewBtn.Text = "GÓC NHÌN: ÉP 1ST"
        ToggleViewBtn.BackgroundColor3 = Theme.Active
        ToggleViewBtn.TextColor3 = Theme.Background
        
        -- Ép góc nhìn thứ nhất
        pcall(function()
            player.CameraMode = Enum.CameraMode.LockFirstPerson
            player.CameraMinZoomDistance = 0.5
            player.CameraMaxZoomDistance = 0.5
        end)
    else
        ToggleViewBtn.Text = "GÓC NHÌN: TỰ DO"
        ToggleViewBtn.BackgroundColor3 = Theme.Panel
        ToggleViewBtn.TextColor3 = Theme.Text
        
        -- Trả về tự do
        pcall(function()
            player.CameraMode = Enum.CameraMode.Classic
            player.CameraMinZoomDistance = 0.5
            player.CameraMaxZoomDistance = 400
        end)
    end
end

-- ================= VÒNG LẶP RENDERSTEP (CHỈ ÉP FOV) =================
-- Thay đổi Priority thành Camera.Value + 1 để mượt hơn, không đánh nhau với CoreScript
RunService:BindToRenderStep("AbsoluteCameraLock_V3", Enum.RenderPriority.Camera.Value + 1, function()
    local cam = workspace.CurrentCamera
    if cam then
        pcall(function()
            -- Chỉ ép FOV nếu nó bị game đổi, không ép CameraType và Offset nữa
            if cam.FieldOfView ~= cameraFOV then
                cam.FieldOfView = cameraFOV
            end
        end)
    end
end)

-- ================= HỆ THỐNG XỬ LÝ FOV =================
local initialDelay = 0.35
local function changeFOV(delta)
    cameraFOV = math.clamp(cameraFOV + delta, 10, 120)
    FovLabel.Text = "FOV: " .. math.floor(cameraFOV + 0.5)
end

local holdingFovAction = 0
local fovHoldTimer = 0

FovIncBtn.MouseButton1Down:Connect(function() holdingFovAction = 1; fovHoldTimer = 0; changeFOV(1) end)
FovIncBtn.MouseButton1Up:Connect(function() if holdingFovAction == 1 then holdingFovAction = 0 end end)
FovIncBtn.MouseLeave:Connect(function() if holdingFovAction == 1 then holdingFovAction = 0 end end)

FovDecBtn.MouseButton1Down:Connect(function() holdingFovAction = -1; fovHoldTimer = 0; changeFOV(-1) end)
FovDecBtn.MouseButton1Up:Connect(function() if holdingFovAction == -1 then holdingFovAction = 0 end end)
FovDecBtn.MouseLeave:Connect(function() if holdingFovAction == -1 then holdingFovAction = 0 end end)

RunService.RenderStepped:Connect(function(dt)
    if holdingFovAction ~= 0 then
        fovHoldTimer = fovHoldTimer + dt
        if fovHoldTimer >= initialDelay then
            changeFOV(holdingFovAction * 25 * dt)
        end
    end
end)

-- ================= KẾT NỐI SỰ KIỆN KHÁC =================
ToggleViewBtn.MouseButton1Click:Connect(function()
    isFirstPerson = not isFirstPerson
    ApplyCameraMode()
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.V then
        isFirstPerson = not isFirstPerson
        ApplyCameraMode()
    end
end)

MinimizeButton.MouseButton1Click:Connect(function()
    isGuiMinimized = not isGuiMinimized
    if isGuiMinimized then
        MinimizeButton.Text = "+"
        InnerFrame.Visible = false
        MainFrame:TweenSize(UDim2.new(0, 170, 0, 35), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.25, true)
    else
        MinimizeButton.Text = "–"
        InnerFrame.Visible = true
        MainFrame:TweenSize(UDim2.new(0, 170, 0, 125), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.25, true)
    end
end)

-- Khởi chạy lần đầu
ApplyCameraMode()

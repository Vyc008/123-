MenuCamAimBtn.Activated:Connect(toggleCamAim); MenuBodyAimBtn.Activated:Connect(toggleBodyAim)

local function getAimbotTargetPart(character) return character and (character:FindFirstChild(AimbotSettings.FocusPart) or character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")) end
local function isAimbotTargetValid(p)
    if not p or not p.Parent or p == Player then return false end
    local char = p.Character; if not char then return false end
    local tPart = getAimbotTargetPart(char); local hum = char:FindFirstChildOfClass("Humanoid")
    if not tPart or not hum or (AimbotSettings.DeadCheck and hum.Health <= 0) then return false end
    if AimbotSettings.TeamCheck and p.Team == Player.Team then return false end
    if AimbotSettings.WallCheck then
        local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude; local ignoreList = {}
        for _, pl in ipairs(Players:GetPlayers()) do if pl.Character then table.insert(ignoreList, pl.Character) end end
        params.FilterDescendantsInstances = ignoreList; params.IgnoreWater = true
        if workspace:Raycast(Cam.CFrame.Position, tPart.Position - Cam.CFrame.Position, params) then return false end
    end
    return true
end

local function getBestAimbotTarget()
    local best = nil; local minDist = math.huge; local center = Cam.ViewportSize / 2
    for _, p in ipairs(Players:GetPlayers()) do
        if isAimbotTargetValid(p) then
            local tPart = getAimbotTargetPart(p.Character)
            local sPos, vis = Cam:WorldToViewportPoint(tPart.Position)
            if vis and sPos.Z > 0 then
                local dist = (Vector2.new(sPos.X, sPos.Y) - center).Magnitude
                if dist <= AimbotSettings.FovRadius and dist < minDist then minDist = dist; best = p end
            end
        end
    end
    return best
end

-- TẠO CÁC OBJECT ESP & FIX LỖI TÀNG HÌNH (HIGHLIGHT LIMIT)
local ESP = {}
local activeHighlights = 0

local function getESPColor(p) return CustomPlayerColors[p.Name] or currentESPColor or (p.Team and p.Team.TeamColor.Color or NO_TEAM_COLOR) end

local function cleanESP(p) 
    if ESP[p] then 
        if ESP[p].Box then ESP[p].Box:Destroy() end
        if ESP[p].HL then ESP[p].HL:Destroy(); activeHighlights = activeHighlights - 1 end
        if ESP[p].BB then ESP[p].BB:Destroy() end
        if ESP[p].Tracer then ESP[p].Tracer:Destroy() end
        ESP[p] = nil 
    end 
end

local function setupESP(p)
    if p == Player then return end; cleanESP(p)
    local box = Instance.new("SelectionBox"); box.LineThickness = 0.05; box.SurfaceTransparency = 1; box.Parent = ScreenGui 
    
    local hl = Instance.new("Highlight"); hl.FillTransparency = 1; hl.OutlineTransparency = 0; hl.Enabled = false
    if activeHighlights < 31 then hl.Parent = ScreenGui; activeHighlights = activeHighlights + 1 end
    
    local bb = Instance.new("BillboardGui"); bb.AlwaysOnTop = true; bb.Size = UDim2.new(0, 200, 0, 50); bb.StudsOffset = Vector3.new(0, 2, 0); bb.Parent = ScreenGui
    local txt = Instance.new("TextLabel"); txt.Size = UDim2.new(1, 0, 1, 0); txt.BackgroundTransparency = 1; txt.Font = Enum.Font.GothamBold; txt.TextSize = 12; txt.TextStrokeTransparency = 0; txt.Parent = bb
    local tracerFrame = Instance.new("Frame"); tracerFrame.AnchorPoint = Vector2.new(0.5, 0.5); tracerFrame.BorderSizePixel = 0; tracerFrame.Visible = false; tracerFrame.Parent = ScreenGui
    
    ESP[p] = { Box = box, HL = hl, BB = bb, TXT = txt, Tracer = tracerFrame }
end
for _, p in pairs(Players:GetPlayers()) do setupESP(p) end
Players.PlayerAdded:Connect(setupESP); Players.PlayerRemoving:Connect(cleanESP)

local function RebuildHighlights()
    for p, e in pairs(ESP) do if e.HL then pcall(function() e.HL:Destroy() end); e.HL = nil end end
    activeHighlights = 0
    for p, e in pairs(ESP) do
        if activeHighlights < 31 then
            local newHl = Instance.new("Highlight"); newHl.FillTransparency = 1; newHl.OutlineTransparency = 0; newHl.Enabled = false; newHl.Parent = ScreenGui
            e.HL = newHl; activeHighlights = activeHighlights + 1
        end
    end
end
UserInputService.WindowFocused:Connect(RebuildHighlights)
FixBtn.Activated:Connect(RebuildHighlights)

-- [ƯU TIÊN 201]: CẬP NHẬT AIMBOT (Di chuyển Camera trước)
RunService:BindToRenderStep("Rromax_Aimbot", Enum.RenderPriority.Camera.Value + 1, function()
    if isAiming or AimbotSettings.BodyAim then
        local hold = false
        if lockedTarget and isAimbotTargetValid(lockedTarget) then
            if AimbotSettings.LockTarget then
                hold = true
            else
                local tPart = getAimbotTargetPart(lockedTarget.Character)
                local sPos, vis = Cam:WorldToViewportPoint(tPart.Position)
                if vis and (Vector2.new(sPos.X, sPos.Y) - Cam.ViewportSize / 2).Magnitude <= AimbotSettings.FovRadius then hold = true end
            end
        end
        if not hold then lockedTarget = getBestAimbotTarget() end

        if lockedTarget and lockedTarget.Character then
            local tPart = getAimbotTargetPart(lockedTarget.Character)
            if isAiming then
                local vel = tPart.AssemblyLinearVelocity; if vel.Magnitude > 100 then vel = vel.Unit * 100 end
                local finalPos = tPart.Position + (vel * (AimbotSettings.EnablePrediction and AimbotSettings.Prediction or 0))
                
                if AimbotSettings.AimMode == "CFrame" then
                    local dir = (finalPos - Cam.CFrame.Position).Unit
                    Cam.CFrame = AimbotSettings.Smooth == 1 and CFrame.new(Cam.CFrame.Position, Cam.CFrame.Position + dir) or CFrame.new(Cam.CFrame.Position, Cam.CFrame.Position + Cam.CFrame.LookVector:Lerp(dir, AimbotSettings.Smooth))
                elseif AimbotSettings.AimMode == "Mouse" and mousemoverel then
                    local sPos, vis = Cam:WorldToViewportPoint(finalPos)
                    if vis then
                        local center = Cam.ViewportSize / 2
                        mousemoverel(math.round((sPos.X - center.X) * AimbotSettings.Smooth), math.round((sPos.Y - center.Y) * AimbotSettings.Smooth))
                    end
                end
            end
            if AimbotSettings.BodyAim and Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
                local myRoot = Player.Character.HumanoidRootPart
                myRoot.CFrame = CFrame.lookAt(myRoot.Position, Vector3.new(tPart.Position.X, myRoot.Position.Y, tPart.Position.Z))
            end
        end
    else lockedTarget = nil end
end)

-- [ƯU TIÊN 202]: CẬP NHẬT UI, TRACER, FOCUS (Chạy sau Aimbot -> Tuyệt đối không giật/lệch)
RunService:BindToRenderStep("Rromax_ESP", Enum.RenderPriority.Camera.Value + 2, function()
    FOVring.Position = UDim2.new(0, Cam.ViewportSize.X / 2, 0, Cam.ViewportSize.Y / 2); FOVring.Size = UDim2.new(0, AimbotSettings.FovRadius * 2, 0, AimbotSettings.FovRadius * 2)

    -- Vẽ Focus
    if lockedTarget and lockedTarget.Character and (isAiming or AimbotSettings.BodyAim) then
        local tPart = getAimbotTargetPart(lockedTarget.Character)
        local sPos, vis = Cam:WorldToViewportPoint(tPart.Position)
        if vis and AimbotSettings.ShowFocus then FocusCircle.Position = UDim2.new(0, sPos.X, 0, sPos.Y); FocusCircle.Visible = true else FocusCircle.Visible = false end
    else FocusCircle.Visible = false end

    -- Vẽ ESP & Tracer
    local origin = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y)
    for p, e in pairs(ESP) do
        local c = p.Character; local hrp = c and c:FindFirstChild("HumanoidRootPart"); local head = c and c:FindFirstChild("Head"); local hum = c and c:FindFirstChildOfClass("Humanoid")
        local isVisible = hrp and head and hum and hum.Health > 0 and (ESPSettings.ESPTeammates or p.Team ~= Player.Team)
        
        if isVisible then
            local col = getESPColor(p)
            e.Box.Visible = ESPSettings.BoxESP; e.Box.Adornee = ESPSettings.BoxESP and c or nil; e.Box.Color3 = col
            
            if ESPSettings.OutlineESP and e.HL then
                e.HL.Enabled = true; e.HL.Adornee = c; e.HL.OutlineColor = col
            elseif e.HL then
                e.HL.Enabled = false; e.HL.Adornee = nil
            end
            
            if ESPSettings.ShowName or ESPSettings.ShowDistance then
                e.BB.Adornee = head; e.BB.Enabled = true; e.TXT.TextColor3 = col
                local str = ""; if ESPSettings.ShowName then str = p.Name end
                if ESPSettings.ShowDistance then str = str .. (ESPSettings.ShowName and "\n" or "") .. "[" .. math.floor((Cam.CFrame.Position - hrp.Position).Magnitude) .. "m]" end
                e.TXT.Text = str
            else e.BB.Enabled = false end
            
            if ESPSettings.TracerESP then
                local pos, onScreen = Cam:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    local target = Vector2.new(pos.X, pos.Y); local dist = (target - origin).Magnitude
                    e.Tracer.Size = UDim2.new(0, dist, 0, 1.5)
                    e.Tracer.Position = UDim2.new(0, (origin.X + target.X) / 2, 0, (origin.Y + target.Y) / 2)
                    e.Tracer.Rotation = math.deg(math.atan2(target.Y - origin.Y, target.X - origin.X))
                    e.Tracer.BackgroundColor3 = col; e.Tracer.Visible = true
                else e.Tracer.Visible = false end
            else e.Tracer.Visible = false end
        else e.Box.Visible = false; if e.HL then e.HL.Enabled = false; e.HL.Adornee = nil end; e.BB.Enabled = false; e.Tracer.Visible = false end
    end
end)


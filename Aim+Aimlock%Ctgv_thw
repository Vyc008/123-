local function getAimbotTargetPart(character) return character and (character:FindFirstChild(AimbotSettings.FocusPart) or character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")) end

local function isAimbotTargetValid(p, isHolding)
    if not p or not p.Parent or p == Player then return false end
    local char = p.Character; if not char then return false end
    local tPart = getAimbotTargetPart(char); local hum = char:FindFirstChildOfClass("Humanoid")
    if not tPart or not hum or (AimbotSettings.DeadCheck and hum.Health <= 0) then return false end
    if AimbotSettings.TeamCheck and p.Team == Player.Team then return false end
    
    if AimbotSettings.WallCheck and not isHolding then
        local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude; local ignoreList = {}
        for _, pl in ipairs(Players:GetPlayers()) do if pl.Character then table.insert(ignoreList, pl.Character) end end
        params.FilterDescendantsInstances = ignoreList; params.IgnoreWater = true
        if workspace:Raycast(Cam.CFrame.Position, tPart.Position - Cam.CFrame.Position, params) then return false end
    end
    return true
end

local function getBestAimbotTarget()
    local best = nil; local minDist = math.huge; local center = Cam.ViewportSize / 2
    for _, p in ipairs(Players:GetPlayers()) do
        if isAimbotTargetValid(p) then
            local tPart = getAimbotTargetPart(p.Character)
            local sPos, vis = Cam:WorldToViewportPoint(tPart.Position)
            if vis and sPos.Z > 0 then
                local dist = (Vector2.new(sPos.X, sPos.Y) - center).Magnitude
                if dist <= AimbotSettings.FovRadius and dist < minDist then minDist = dist; best = p end
            end
        end
    end
    return best
end


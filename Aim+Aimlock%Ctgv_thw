    MasterAimbotToggleBtn.Text = MasterSwitch and "⚡ AIMBOT TỔNG: ON" or "⚡ AIMBOT TỔNG: OFF"; MasterAimbotToggleBtn.BackgroundColor3 = MasterSwitch and Color3.fromRGB(80, 150, 80) or Color3.fromRGB(60, 60, 65)
    MenuCamAimBtn.Text = "🎯 CAM AIM (CHÍNH): " .. (PrefCamAim and "ON" or "OFF"); MenuCamAimBtn.BackgroundColor3 = PrefCamAim and (MasterSwitch and Color3.fromRGB(80, 150, 80) or Color3.fromRGB(150, 150, 40)) or Color3.fromRGB(60, 60, 65)
    MenuBodyAimBtn.Text = "🧍 BODY AIM: " .. (PrefBodyAim and "ON" or "OFF"); MenuBodyAimBtn.BackgroundColor3 = PrefBodyAim and (MasterSwitch and Color3.fromRGB(80, 150, 80) or Color3.fromRGB(150, 150, 40)) or Color3.fromRGB(60, 60, 65)
    MasterFloatingBtn.Text = "TỔNG: " .. (MasterSwitch and "ON" or "OFF") .. "\nC:" .. (PrefCamAim and "ON" or "OFF") .. " | B:" .. (PrefBodyAim and "ON" or "OFF")
    MasterFloatingBtn.BackgroundColor3 = MasterSwitch and Color3.fromRGB(80, 200, 80) or Color3.fromRGB(220, 60, 60)
    FOVring.Visible = (isAiming or AimbotSettings.BodyAim) and AimbotSettings.ShowFov
    if not isAiming and not AimbotSettings.BodyAim then lockedTarget = nil; FocusCircle.Visible = false end
end

